{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@angular-large-app/shared/ui-button": ["libs/shared/ui-button/src/index.ts"],
      "@angular-large-app/shared/ui-button/ui-button": [
        "libs/shared/ui-button/ui-button/src/index.ts"
      ],
      "@angular-large-app/shared/ui-input": ["libs/shared/ui-input/src/index.ts"],
      "@angular-large-app/shared/ui-table": ["libs/shared/ui-table/src/index.ts"],
      "@angular-large-app/shared/ui-modal": ["libs/shared/ui-modal/src/index.ts"],
      "@angular-large-app/dashboard/data-access-metrics": [
        "libs/dashboard/data-access-metrics/src/index.ts"
      ],
      "@angular-large-app/dashboard/feat-dashboard": ["libs/dashboard/feat-dashboard/src/index.ts"],
      "@angular-large-app/settings/data-access-settings": [
        "libs/settings/data-access-settings/src/index.ts"
      ]
    },
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": false
  },
  "exclude": ["node_modules", "tmp"]
}

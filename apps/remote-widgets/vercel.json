{
  "buildCommand": "pnpm exec nx build remote-widgets --configuration=production",
  "outputDirectory": "../../dist/apps/remote-widgets",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*\\.(js|css|png|jpg|svg|woff2|woff|ico)$)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "cors": {
    "origin": "*",
    "methods": "GET, OPTIONS",
    "maxAge": "86400"
  }
}

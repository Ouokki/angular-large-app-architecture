        <target>Utilisez n'importe quel identifiant et mot de passe. Il s'agit d'une session d'authentification simulée en local.</target>
      </trans-unit>

      <trans-unit id="login.username" datatype="html">
        <source>Email or username</source>
        <target>E-mail ou nom d'utilisateur</target>
      </trans-unit>

      <trans-unit id="login.password" datatype="html">
        <source>Password</source>
        <target>Mot de passe</target>
      </trans-unit>

      <trans-unit id="login.submit" datatype="html">
        <source>Sign in</source>
        <target>Se connecter</target>
      </trans-unit>


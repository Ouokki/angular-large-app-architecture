      <trans-unit id="nav.dashboard" datatype="html">
        <source>Dashboard</source>
        <target>Tableau de bord</target>
      </trans-unit>

      <trans-unit id="nav.settings" datatype="html">
        <source>Settings</source>
        <target>Paramètres</target>
      </trans-unit>

      <trans-unit id="nav.widgets" datatype="html">
        <source>Widgets</source>
        <target>Widgets</target>
      </trans-unit>

      <!-- Settings page -->
      <trans-unit id="settings.title" datatype="html">
        <source>Account settings</source>
        <target>Paramètres du compte</target>
      </trans-unit>

      <trans-unit id="settings.save" datatype="html">
        <source>Save settings</source>
        <target>Enregistrer les paramètres</target>
      </trans-unit>

      <trans-unit id="settings.saving" datatype="html">
        <source>Saving…</source>
        <target>Enregistrement…</target>
      </trans-unit>

      <trans-unit id="settings.saved" datatype="html">
        <source>Saved</source>
        <target>Enregistré</target>
      </trans-unit>


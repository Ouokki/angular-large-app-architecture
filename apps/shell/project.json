{
  "name": "shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/shell/src",
  "tags": ["scope:shell", "type:feat"],
  "targets": {
    "build": {
      "executor": "@nx/angular:webpack-browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/shell",
        "index": "apps/shell/src/index.html",
        "main": "apps/shell/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/shell/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/shell/public"
          }
        ],
        "styles": ["apps/shell/src/styles.scss"],
        "scripts": [],
        "customWebpackConfig": {
          "path": "apps/shell/webpack.config.ts"
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "350kb",
              "maximumError": "600kb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            },
            {
              "type": "anyScript",
              "maximumWarning": "150kb",
              "maximumError": "700kb"
            }
          ],
          "outputHashing": "all",
          "optimization": {
            "scripts": true,
            "styles": {
              "minify": true,
              "inlineCritical": true
            },
            "fonts": true
          }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve-host": {
      "executor": "@nx/angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "shell:build:production"
        },
        "development": {
          "buildTarget": "shell:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4200,
        "publicHost": "http://localhost:4200"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "options": {
        "parallel": true,
        "commands": [
          {
            "command": "pnpm exec nx run remote-widgets:serve:development",
            "prefix": "remote-widgets",
            "color": "cyan",
            "forwardAllArgs": false
          },
          {
            "command": "pnpm exec nx run shell:serve-host:development",
            "prefix": "shell",
            "color": "green",
            "forwardAllArgs": false
          }
        ]
      },
      "configurations": {
        "production": {
          "commands": [
            {
              "command": "pnpm exec nx run remote-widgets:serve:production",
              "prefix": "remote-widgets",
              "color": "cyan",
              "forwardAllArgs": false
            },
            {
              "command": "pnpm exec nx run shell:serve-host:production",
              "prefix": "shell",
              "color": "green",
              "forwardAllArgs": false
            }
          ]
        },
        "development": {}
      }
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "shell:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/shell/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "shell:build",
        "staticFilePath": "dist/apps/shell/browser",
        "spa": true
      }
    }
  }
}
